{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Path mappings
    "baseUrl": "..",
    "paths": {
      "@server/*": ["./server/*"],
      "@shared/*": ["./shared/*"]
    },

    // Stricter checks for server code
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,

    "types": ["bun-types"]
  },
  "include": [
    "../server/**/*",
    "../scripts/**/*",
    "../shared/**/*",
    "../app.ts"
  ]
}
